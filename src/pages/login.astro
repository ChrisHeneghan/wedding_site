---
import Base from '../layouts/Base.astro';
---

<Base title="Morgan & Chris — Enter">
  <main class="gate">
    <div class="gate-card">
      <div class="monogram" aria-hidden="true">M &amp; C</div>
      <h1 class="gate-heading">You're invited.</h1>
      <p class="gate-sub">Please enter the password to continue.</p>

      <form class="gate-form" method="POST" action="/login">
        <label for="password" class="visually-hidden">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          class="gate-input"
          placeholder="Password"
          autocomplete="current-password"
          required
        />
        <button type="submit" class="gate-btn">Enter</button>
      </form>

      <p class="gate-hint">July 9, 2027 · Notre Dame, Indiana</p>
    </div>
  </main>
</Base>

<style>
  .gate {
    min-height: 100vh;
    background-color: var(--nd-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .gate-card {
    text-align: center;
    max-width: 380px;
    width: 100%;
  }

  .monogram {
    font-size: 1.25rem;
    letter-spacing: 0.35em;
    color: var(--nd-gold);
    text-transform: uppercase;
    margin-bottom: 2rem;
    font-style: italic;
  }

  .gate-heading {
    font-size: 2.75rem;
    font-weight: 400;
    color: var(--white);
    letter-spacing: 0.04em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .gate-sub {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 2rem;
    font-style: italic;
  }

  .gate-form {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-bottom: 2rem;
  }

  .gate-input {
    width: 100%;
    padding: 0.85rem 1rem;
    font-family: inherit;
    font-size: 1rem;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(201, 151, 0, 0.35);
    border-radius: 2px;
    color: var(--white);
    text-align: center;
    letter-spacing: 0.1em;
    outline: none;
    transition: border-color 0.2s;
  }

  .gate-input::placeholder {
    color: rgba(255, 255, 255, 0.3);
    letter-spacing: 0.05em;
  }

  .gate-input:focus {
    border-color: var(--nd-gold);
    background: rgba(255, 255, 255, 0.1);
  }

  .gate-btn {
    width: 100%;
    padding: 0.85rem 1rem;
    font-family: inherit;
    font-size: 1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background-color: var(--nd-gold);
    color: var(--nd-navy);
    border: none;
    border-radius: 2px;
    cursor: pointer;
    transition: background-color 0.2s;
    font-weight: 600;
  }

  .gate-btn:hover {
    background-color: var(--nd-gold-light);
  }

  .gate-hint {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.3);
  }
</style>
